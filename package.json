{
  "name": "@beter-life/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "compact": "node scripts/compact.mjs",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint src tests scripts *.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "node --env-file-if-exists=.env --import tsx scripts/integration.ts",
    "test:postgres": "node scripts/test-postgres.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "openapi:generate": "tsx scripts/openapi.ts",
    "openapi:check": "tsx scripts/openapi.ts --check",
    "security:scan": "node scripts/secret-scan.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "5.0.1"
  }
}
