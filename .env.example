# Copy locally only; replace blank values through secure environment configuration.
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
DATABASE_URL=
DATABASE_SSL=verify-full
DATABASE_POOL_MAX=5
# Optional PEM certificate for a provider CA not in the system trust store.
DATABASE_CA_CERT=
TEST_DATABASE_URL=
SUPABASE_URL=
JWT_ALGORITHM=ES256
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
BODY_LIMIT_BYTES=16384
RATE_LIMIT_MAX=100
# Set 1 only behind a verified single trusted reverse proxy, e.g. Render.
TRUST_PROXY_HOPS=0
SHUTDOWN_TIMEOUT_MS=15000
